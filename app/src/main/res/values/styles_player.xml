<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="Theme.TorrentTV.Player" parent="Theme.MaterialComponents.NoActionBar">
		<item name="android:windowBackground">@android:color/black</item>
		<item name="android:windowFullscreen">true</item>
		<item name="colorPrimary">@color/dark_primaryColor</item>
		<item name="colorAccent">@color/dark_button_primaryColor</item>
		<item name="colorSecondary">@color/dark_button_primaryColor</item>
	</style>

	<style name="PlayerButton">
		<item name="android:layout_width">52dp</item>
		<item name="android:layout_height">52dp</item>
		<item name="android:layout_marginStart">4dp</item>
		<item name="android:layout_marginEnd">4dp</item>
		<item name="android:padding">12dp</item>
		<item name="android:scaleType">fitCenter</item>
		<item name="android:background">@drawable/player_button_bg</item>
		<item name="android:focusable">true</item>
	</style>

	<style name="PlayerButton.Big">
		<item name="android:layout_width">68dp</item>
		<item name="android:layout_height">68dp</item>
		<item name="android:padding">14dp</item>
	</style>

	<style name="PlayerTime">
		<item name="android:layout_width">wrap_content</item>
		<item name="android:layout_height">wrap_content</item>
		<item name="android:minWidth">56dp</item>
		<item name="android:gravity">center</item>
		<item name="android:textColor">#FFFFFFFF</item>
		<item name="android:textSize">14sp</item>
		<item name="android:fontFeatureSettings">tnum</item>
	</style>
	<style name="Theme.TorrentTV.Library" parent="Theme.MaterialComponents.NoActionBar">
		<item name="android:windowBackground">@color/library_bg</item>
		<item name="android:statusBarColor">#FF3B45C8</item>
		<item name="colorPrimary">@color/dark_primaryColor</item>
		<item name="colorAccent">@color/dark_button_primaryColor</item>
		<item name="colorSecondary">@color/dark_button_primaryColor</item>
	</style>
</resources>
