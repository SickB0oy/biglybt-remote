<?xml version="1.0" encoding="utf-8"?>
<!-- One poster; focusable for the TV remote -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_margin="6dp"
	android:background="@drawable/library_item_bg"
	android:clickable="true"
	android:focusable="true"
	android:orientation="vertical"
	android:padding="4dp">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<com.biglybt.android.client.media.PosterImageView
			android:id="@+id/item_poster"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/library_poster_placeholder"
			android:contentDescription="@null"
			android:scaleType="centerCrop" />

		<TextView
			android:id="@+id/item_fallback"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center"
			android:padding="10dp"
			android:textColor="#FFFFFFFF"
			android:textSize="15sp"
			android:textStyle="bold"
			android:visibility="gone" />

		<TextView
			android:id="@+id/item_seen"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|end"
			android:layout_margin="6dp"
			android:background="@drawable/library_badge_bg"
			android:paddingStart="8dp"
			android:paddingTop="2dp"
			android:paddingEnd="8dp"
			android:paddingBottom="2dp"
			android:text="@string/library_seen"
			android:textColor="#FFFFFFFF"
			android:textSize="11sp"
			android:visibility="gone" />

		<TextView
			android:id="@+id/item_resume"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom|start"
			android:layout_margin="6dp"
			android:background="@drawable/library_badge_bg"
			android:paddingStart="8dp"
			android:paddingTop="2dp"
			android:paddingEnd="8dp"
			android:paddingBottom="2dp"
			android:text="@string/library_in_progress"
			android:textColor="#FFFFFFFF"
			android:textSize="11sp"
			android:visibility="gone" />
	</FrameLayout>

	<TextView
		android:id="@+id/item_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:ellipsize="end"
		android:maxLines="2"
		android:textColor="@color/library_text"
		android:textSize="14sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/item_subtitle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textColor="@color/library_muted"
		android:textSize="12sp" />
</LinearLayout>
