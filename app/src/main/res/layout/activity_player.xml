<?xml version="1.0" encoding="utf-8"?>
<!-- Torrent TV: built-in player. Video fills the screen, controls float on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#FF000000">

	<org.videolan.libvlc.util.VLCVideoLayout
		android:id="@+id/player_video"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:focusable="true"
		android:focusableInTouchMode="false" />

	<FrameLayout
		android:id="@+id/player_controls"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<!-- Top: back and title -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="top"
			android:background="@drawable/player_scrim_top"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="16dp"
			android:paddingTop="16dp"
			android:paddingEnd="24dp"
			android:paddingBottom="40dp">

			<ImageButton
				android:id="@+id/player_back"
				style="@style/PlayerButton"
				android:contentDescription="@string/player_back"
				android:src="@drawable/ic_player_back" />

			<TextView
				android:id="@+id/player_title"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:ellipsize="end"
				android:maxLines="2"
				android:textColor="#FFFFFFFF"
				android:textSize="18sp"
				android:textStyle="bold" />
		</LinearLayout>

		<!-- Bottom: timeline and buttons -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom"
			android:background="@drawable/player_scrim_bottom"
			android:orientation="vertical"
			android:paddingStart="24dp"
			android:paddingTop="48dp"
			android:paddingEnd="24dp"
			android:paddingBottom="20dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/player_time"
					style="@style/PlayerTime"
					android:text="0:00" />

				<SeekBar
					android:id="@+id/player_seek"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:progressBackgroundTint="#66FFFFFF"
					android:progressTint="#FF8A93F7"
					android:thumbTint="#FFFFFFFF" />

				<TextView
					android:id="@+id/player_length"
					style="@style/PlayerTime"
					android:text="0:00" />
			</LinearLayout>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:gravity="center"
				android:orientation="horizontal">

				<ImageButton
					android:id="@+id/player_audio"
					style="@style/PlayerButton"
					android:contentDescription="@string/player_audio"
					android:src="@drawable/ic_player_audio" />

				<ImageButton
					android:id="@+id/player_subtitles"
					style="@style/PlayerButton"
					android:contentDescription="@string/player_subtitles"
					android:src="@drawable/ic_player_subtitles" />

				<Space
					android:layout_width="24dp"
					android:layout_height="1dp" />

				<ImageButton
					android:id="@+id/player_rewind"
					style="@style/PlayerButton"
					android:contentDescription="@string/player_rewind"
					android:src="@drawable/ic_player_rewind" />

				<ImageButton
					android:id="@+id/player_play"
					style="@style/PlayerButton.Big"
					android:contentDescription="@string/player_pause"
					android:src="@drawable/ic_player_pause" />

				<ImageButton
					android:id="@+id/player_forward"
					style="@style/PlayerButton"
					android:contentDescription="@string/player_forward"
					android:src="@drawable/ic_player_forward" />

				<Space
					android:layout_width="24dp"
					android:layout_height="1dp" />

				<ImageButton
					android:id="@+id/player_aspect"
					style="@style/PlayerButton"
					android:contentDescription="@string/player_aspect"
					android:src="@drawable/ic_player_aspect" />
			</LinearLayout>
		</LinearLayout>
	</FrameLayout>
</FrameLayout>
